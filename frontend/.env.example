# Base URL of the BHUMI backend API (FastAPI service).
# Leave this UNSET to run the app in self-contained demo mode — an in-browser
# backend with realistic sample data, so every page works with no server.
# Set it to your backend's public URL to use the live API instead,
# e.g. https://api.bhumi.example.com (must be reachable from the browser).
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Force demo mode on even when NEXT_PUBLIC_API_URL is set. Defaults to demo
# whenever NEXT_PUBLIC_API_URL is empty.
# NEXT_PUBLIC_DEMO_MODE=true
