# One free Render service: FalkorDB on localhost plus the API.
# Embeddings are off so the process stays inside the free memory limit.
FROM falkordb/falkordb:latest

USER root
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8000 \
    FALKORDB_HOST=127.0.0.1 \
    FALKORDB_PORT=6379 \
    FALKORDB_GRAPH=bhumi_company_brain \
    EMBEDDINGS_ENABLED=0

# No tesseract on the free image — it breaks apt on the FalkorDB base; OCR stays in local Docker only.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-free.txt .
RUN pip3 install --break-system-packages --no-cache-dir -r requirements-free.txt

COPY . .
RUN chmod +x /app/docker-entrypoint.free.sh \
    && test -f /var/lib/falkordb/bin/falkordb.so \
    && test -f /var/lib/falkordb/bin/run.sh

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=50s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${PORT}/health" || exit 1

ENTRYPOINT ["/app/docker-entrypoint.free.sh"]
