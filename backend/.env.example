# ── Datastores ──────────────────────────────────────────────────────────────
# Async SQLAlchemy URL for Postgres (must have the pgvector extension available).
DATABASE_URL=postgresql+asyncpg://bhumi:bhumi_dev_pw@localhost:55432/bhumi

# S3-compatible object storage (MinIO locally, AWS S3 / R2 / etc. in production).
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=bhumi_minio
S3_SECRET_KEY=bhumi_minio_pw
S3_BUCKET=bhumi-documents

# Neo4j knowledge graph.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bhumi_dev_pw

# ── Web / security ─────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins (your Vercel frontend URL).
CORS_ORIGINS=http://localhost:3000

# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480

# Number of uvicorn workers (each loads its own copy of the embedding model).
WEB_CONCURRENCY=1

# ── AI services ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Speech-to-text / text-to-speech across Indian languages; blank falls back to browser APIs.
SARVAM_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Bootstrap / demo accounts ──────────────────────────────────────────────
# Creates the first Administrator on an empty database; clear after first boot.
BOOTSTRAP_ADMIN_EMPLOYEE_ID=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional demo accounts, one per role card on /select-role.
DEMO_PARLIAMENTARY_EMPLOYEE_ID=
DEMO_PARLIAMENTARY_PASSWORD=
DEMO_MINISTRY_EMPLOYEE_ID=
DEMO_MINISTRY_PASSWORD=
DEMO_DOMAIN_OFFICER_EMPLOYEE_ID=
DEMO_DOMAIN_OFFICER_PASSWORD=
DEMO_ADMIN_EMPLOYEE_ID=
DEMO_ADMIN_PASSWORD=
