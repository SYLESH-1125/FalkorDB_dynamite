OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# powers the voice assistant's speech-to-text and text-to-speech across Indian languages
# get a key at https://dashboard.sarvam.ai — leave blank to fall back to the browser's built-in speech APIs
SARVAM_API_KEY=

# generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# creates the first Administrator account on an empty database; leave blank after first boot
BOOTSTRAP_ADMIN_EMPLOYEE_ID=
BOOTSTRAP_ADMIN_PASSWORD=

# optional demo accounts, one per role card on /select-role; leave any pair blank to skip it
DEMO_PARLIAMENTARY_EMPLOYEE_ID=
DEMO_PARLIAMENTARY_PASSWORD=
DEMO_MINISTRY_EMPLOYEE_ID=
DEMO_MINISTRY_PASSWORD=
DEMO_DOMAIN_OFFICER_EMPLOYEE_ID=
DEMO_DOMAIN_OFFICER_PASSWORD=
DEMO_ADMIN_EMPLOYEE_ID=
DEMO_ADMIN_PASSWORD=
